{%- liquid
  assign recipes = section.blocks | where: 'type', 'recipe'
  assign s = section.settings
-%}
{{ 'ssko-v10.css' | asset_url | stylesheet_tag }}
<div class="ssko-v10-book">
  <header class="ssko-v10-intro wrap">
    <p class="mono">{{ s.eyebrow | escape }}</p>
    <h1>{{ s.heading | escape }} <em>{{ s.emphasis | escape }}</em></h1>
    <p class="ssko-v10-lede">{{ s.intro | escape }}</p>
    <ol class="ssko-v10-index mono" aria-label="Recipes">
      {%- for r in recipes -%}
        <li><a href="#{{ r.settings.anchor | escape }}"><span>{{ r.settings.number | escape }}</span> {{ r.settings.title | escape }} {{ r.settings.emphasis | escape }}</a></li>
      {%- endfor -%}
    </ol>
  </header>

  {%- for r in recipes -%}
    {%- liquid
      assign rs = r.settings
      assign lines = rs.ingredients | strip | newline_to_br | split: '<br />'
      assign steps = rs.method | strip | newline_to_br | split: '<br />'
      assign cart = 'https://www.amazon.com/gp/aws/cart/add.html?'
      assign sets = 0
      for line in lines
        assign p = line | split: '|'
        assign q = p[0] | strip | plus: 0
        assign asin = p[4] | strip
        assign n = forloop.index
        if forloop.first == false
          assign cart = cart | append: '&'
        endif
        assign cart = cart | append: 'ASIN.' | append: n | append: '=' | append: asin | append: '&Quantity.' | append: n | append: '=' | append: q
        assign sets = sets | plus: q
      endfor
    -%}
    <article class="ssko-v10-recipe{% cycle '', ' is-flip' %}" id="{{ rs.anchor | escape }}" aria-labelledby="ssko-v10-r-{{ r.id }}" {{ r.shopify_attributes }}>
      <figure class="ssko-v10-photo">
        {%- if rs.image != blank or rs.image_asset != blank -%}
          {% render 'ssko-v09-img', image: rs.image, asset: rs.image_asset, alt: rs.alt, width: 1600, sizes: '(min-width: 901px) 56vw, 100vw', loading: 'lazy' %}
          {%- if rs.photo_review -%}<figcaption class="ssko-v10-review mono">Styling image · under review</figcaption>{%- endif -%}
        {%- else -%}
          <div class="ssko-v10-pending">
            <span class="ssko-v10-pending__dots" aria-hidden="true">
              {%- for line in lines -%}{%- assign p = line | split: '|' -%}<i style="--c:{{ p[5] | strip }}"></i>{%- endfor -%}
            </span>
            <span class="mono">Photograph in production</span>
          </div>
        {%- endif -%}
      </figure>
      <div class="ssko-v10-card">
        <p class="mono ssko-v10-card__kicker">No. {{ rs.number | escape }} · {{ rs.palette | escape }} · {{ rs.stems | escape }} stems</p>
        <h2 id="ssko-v10-r-{{ r.id }}">{{ rs.title | escape }} <em>{{ rs.emphasis | escape }}</em></h2>
        <p class="ssko-v10-card__why">{{ rs.why | escape }}</p>

        <ul class="ssko-v10-items" aria-label="What you need">
          {%- for line in lines -%}
            {%- assign p = line | split: '|' -%}
            <li>
              <span class="ssko-v10-items__dot" style="--c:{{ p[5] | strip }}" aria-hidden="true"></span>
              <a href="{{ p[6] | strip | escape }}"><b>{{ p[1] | strip | escape }}</b> {{ p[2] | strip | escape }}</a>
              <span class="mono ssko-v10-items__meta">{{ p[0] | strip }} × {{ p[3] | strip | escape }}{% if p[7] != blank %} · {{ p[7] | strip | escape }}{% endif %}</span>
            </li>
          {%- endfor -%}
        </ul>

        <p class="ssko-v10-vessel">
          {% render 'ssko-v10-vessel', type: rs.vessel_type %}
          <span>{{ rs.vessel_name | escape }}<span class="mono">Suggested: about {{ rs.vessel_height | escape }} cm tall{% if rs.vessel_opening != blank %} · {{ rs.vessel_opening | escape }} cm opening{% else %}, wide mouth{% endif %} · not included</span></span>
        </p>

        <a class="btn dark ssko-v10-buy" href="{{ cart | escape }}">{% if sets == 1 %}Add the set to your Amazon cart{% elsif sets == 2 %}Add both sets to your Amazon cart{% else %}Add all {{ sets }} sets to your Amazon cart{% endif %} {% render 'sskoi-arrow' %}</a>

        <details class="ssko-v10-how">
          <summary>How to arrange</summary>
          <ol>
            {%- for step in steps -%}{%- assign t = step | strip -%}{%- if t != blank -%}<li>{{ t | escape }}</li>{%- endif -%}{%- endfor -%}
          </ol>
        </details>
      </div>
    </article>
  {%- endfor -%}

  <footer class="ssko-v10-foot wrap"><p>{{ s.footnote | escape }}</p></footer>
</div>

{% schema %}
{
  "name": "SSKOI arrangement book",
  "max_blocks": 12,
  "settings": [
    {"type":"text","id":"eyebrow","label":"Small heading","default":"The arrangement book"},
    {"type":"text","id":"heading","label":"Heading","default":"Arrangements,"},
    {"type":"text","id":"emphasis","label":"Heading accent","default":"by the recipe."},
    {"type":"textarea","id":"intro","label":"Introduction"},
    {"type":"textarea","id":"footnote","label":"Footnote"}
  ],
  "blocks": [
    {"type":"recipe","name":"Recipe","settings":[
      {"type":"text","id":"number","label":"Number"},
      {"type":"text","id":"title","label":"Title"},
      {"type":"text","id":"emphasis","label":"Title accent"},
      {"type":"text","id":"anchor","label":"Link name","info":"Used in the page address, for example coral-hour"},
      {"type":"image_picker","id":"image","label":"Photo (4:5)"},
      {"type":"text","id":"image_asset","label":"Theme photo filename (used when no photo is picked)"},
      {"type":"text","id":"alt","label":"Photo description"},
      {"type":"checkbox","id":"photo_review","label":"Show the Photo under review tag","default":false},
      {"type":"text","id":"palette","label":"Color pairing","info":"For example Tonal or Analogous"},
      {"type":"text","id":"stems","label":"Total stems"},
      {"type":"textarea","id":"why","label":"Why the pairing works"},
      {"type":"textarea","id":"ingredients","label":"Ingredients","info":"One per line: quantity | set name | color | set size | ASIN | swatch | link | role"},
      {"type":"select","id":"vessel_type","label":"Vessel drawing","options":[{"value":"bowl","label":"Bowl"},{"value":"cylinder","label":"Cylinder"},{"value":"jug","label":"Jug"},{"value":"urn","label":"Urn"},{"value":"jar","label":"Wide-mouth jar"},{"value":"bud","label":"Two bud vases"},{"value":"crock","label":"Crock"},{"value":"bottle","label":"Bottle"},{"value":"pair","label":"Paper vase and glass vase"}],"default":"urn"},
      {"type":"text","id":"vessel_name","label":"Vessel"},
      {"type":"text","id":"vessel_height","label":"Suggested vessel height (cm)"},
      {"type":"text","id":"vessel_opening","label":"Vessel opening (cm)","info":"Leave blank to show wide mouth"},
      {"type":"textarea","id":"method","label":"How to arrange","info":"One step per line"}
    ]}
  ],
  "presets": [{"name":"SSKOI arrangement book"}]
}
{% endschema %}
